# === FastAPI 백엔드 런타임 경량 컨테이너 ===
FROM python:3.12-slim

# 1. 시스템 필수 의존성 설치 (Kiwi 빌드용 컴파일러, curl 헬스체크용)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. 파이썬 의존성 설치 (PyTorch CPU 전용으로 경량화 빌드)
COPY requirements.txt .

# CPU 전용 PyTorch 및 핵심 라이브러리 우선 설치로 이미지 크기 최소화 (설치 실패는 빌드 실패)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

# 3. 애플리케이션 소스코드 및 필수 정적 에셋 복사
COPY api_server.py \
     local_llm_gate.py \
     retriever.py \
     retriever_kiwi_patch.py \
     evaluator.py \
     llm_handler.py \
     model_registry.py \
     bootstrap.py \
     contracts.py \
     schema.py \
     validation.py \
     rag_run.py \
     rag_core.py \
     sse.py \
     settings.py \
     session_manager.py \
     session_auth.py \
     error_envelope.py \
     errors.py \
     text_norm.py \
     search_constants.py \
     workflow_orchestrator.py \
     index.html \
     DEMO_DISCLAIMER.txt \
     openrouter_models.json \
     prompts_ko_세무.json \
     prompts_en_세무.json \
     embedding_models.json \
     reranker_models.json \
     ./

COPY database/ ./database/

# 4. 로그 및 세션 임시 디렉토리 생성
RUN mkdir -p logs

# 5. 포트 노출 및 단일 워커 Uvicorn 기동 (workers=1 아키텍처)
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
