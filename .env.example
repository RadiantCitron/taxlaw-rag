# =============================================================================
# taxlaw-rag — 환경변수 예시
# =============================================================================
# 사용법:  cp .env.example .env   후 값을 채운다.
#
# 각 항목에 "안 넣으면 무슨 일이 생기는지" 를 적었다.
# 잘못된 값은 대부분 부팅을 막지 않고 경고만 남긴 뒤 기본값을 쓴다.
# 부팅 후  GET /health  의  boot.env_warnings  를 반드시 한 번 확인할 것.
# =============================================================================


# -----------------------------------------------------------------------------
# [필수]  없으면 서버가 기동하지 않는다
# -----------------------------------------------------------------------------

# 답변 생성과 질문 확장에 쓰는 메인 LLM.
#   openrouter:<slug>      예) openrouter:google/gemini-3.5-flash-lite
#   local:<파일명.gguf>    예) local:qwen2.5-7b-instruct-q4_k_m.gguf
#
# 안 넣으면:  [Fatal Error] .env 파일에 DEFAULT_LLM 환경변수가 없습니다.
#             → settings.require_server_env() 가 import 시점에 RuntimeError
#
# ⚠️ local: 로 바꾸면 동시 추론이 1건으로 제한된다(_local_sem). 설계다.
#    그리고 서로 다른 GGUF 를 여러 개 쓰면 캐시에 쌓여 OOM 이 난다(알려진 한계).
DEFAULT_LLM=openrouter:google/gemini-3.5-flash-lite

# PostgreSQL 연결 문자열. pgvector + pg_trgm 확장이 설치돼 있어야 한다.
#
# 안 넣으면:  [Fatal Error] TAX_DB_URI 환경변수가 없습니다.
# 확장이 없으면: [Fatal Error] PostgreSQL 확장이 없습니다: ['vector', 'pg_trgm']
#                → psql -d <DB> -f database/init.sql 실행
TAX_DB_URI=postgresql://user:password@localhost:5432/mydb

# Docker Compose(./deploy.sh)로 띄울 때 쓰는 DB 비밀번호. 직접 정해서 넣는다.
# 안 넣으면:  docker compose up 이 "POSTGRES_PASSWORD 를 설정하세요" 오류로 멈춘다.
# ⚠️ 접속 주소에 들어가므로 영문·숫자만 쓰는 것을 권한다. NEO4J_PASSWORD(아래)도 같은 이유로 필요하다(8자 이상).
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# [권장]  없으면 특정 기능이 조용히 죽는다
# -----------------------------------------------------------------------------

# OpenRouter API 키.
# 안 넣으면:  openrouter: 모델 로드 시 "OPENROUTER_API_KEY가 없습니다."
#             → UNKNOWN_MODEL 로 요청이 거부된다. 부팅은 성공한다.
# local: 만 쓸 거면 비워도 된다.
OPENROUTER_API_KEY=

# DeepEval 채점용 LLM. eval_settings.enabled=true 일 때만 쓰인다.
# 안 넣으면:  openrouter:google/gemini-3.5-flash-lite 를 쓴다.
#
# ⚠️ local: 을 넣으면 평가할 때도 _local_sem 을 잡는다. 메인 LLM 과 경쟁한다.
DEFAULT_EVAL_LLM=openrouter:google/gemini-3.5-flash-lite

# 프롬프트 JSON 경로. 상대경로면 프로젝트 루트 옆을 먼저 찾는다.
# 안 넣으면:  prompts_ko_세무.json 을 찾는다.
# 파일이 없거나 main_answer 가 비면:
#             [Fatal Error] 프롬프트 파일에 main_answer 가 비어 있습니다.
#
# ⚠️ main_answer 가 비면 답변 품질이 급락한다. 부팅 단계에서 막는 이유다.
DEFAULT_PROMPT_FILE=prompts_ko_세무.json

# DB 의 embedding 컬럼을 만든 임베딩 모델.
# 안 넣으면:  jhgan/ko-sroberta-multitask
#
# ⚠️ 여기 넣는 값은 embedding_models.json 에서 "indexed": true 인 항목이어야 한다.
#    아니면 무시되고 카탈로그의 첫 indexed 항목이 쓰인다.
#    DB 인덱스와 다른 모델을 쓰면 벡터 검색 결과가 전부 무의미해진다.
#    (그래서 validate_embed_model 이 indexed 아닌 모델을 거부한다)
RAG_EMBEDDING_MODEL_ID=jhgan/ko-sroberta-multitask

# 기본 리랭커. rerank_settings.enabled=true 일 때만 로드된다.
# 안 넣으면:  Dongjin-kr/ko-reranker (또는 reranker_models.json 첫 항목)
RAG_RERANKER_MODEL_ID=Dongjin-kr/ko-reranker

# Hugging Face 임베딩/리랭커 캐시 위치 (안 넣으면 Hugging Face 기본 위치). 바꾸려면 절대경로로 지정.
# gated 모델은 HF_TOKEN 도 필요할 수 있다.
# HF_HOME=/path/to/hf-cache
HF_TOKEN=

# 법제처 Open API 인증키(OC). db_build/01_collect_tax_data.py 로 코퍼스를 수집할 때만 필요하다(서버 실행에는 불필요).
# open.law.go.kr 에서 본인이 직접 신청해 발급받는다. 절대 커밋·공유하지 말 것.
# 안 넣으면:  [FATAL ERROR] LAW_OC_KEY 환경변수가 필요합니다. (수집 스크립트 시작 시)
LAW_OC_KEY=


# -----------------------------------------------------------------------------
# [선택]  없어도 잘 돈다. 기본값이 합리적이다.
# -----------------------------------------------------------------------------

# 서버 캡처 등급 = 상한.  lean | full | forensic
#   lean      세션 JSONL 만
#   full      + logs/runs/{sid}/{run_id}.json 덤프 (검색 후보/문서 포함)
#   forensic  + LLM 프롬프트 전문 (trace_prompts 강제 ON)
#
# 안 넣으면:  lean
# 이상한 값:  경고 후 lean.  [SETTINGS] RAG_CAPTURE=... 는 lean|full|forensic 이 아닙니다.
#
# ⚠️ 클라이언트가 이보다 높은 등급을 요청해도 이 값으로 내려간다. 그게 목적이다.
# ⚠️ forensic 으로 오래 돌리면 디스크가 찬다. 로그 로테이션이 없다(알려진 한계).
#    덤프 하나가 수백 KB 가 될 수 있다.
RAG_CAPTURE=lean

# LLM 샘플링 온도.  0.0 ~ 2.0
# 안 넣으면:  0.1
# 숫자가 아니면: 경고 후 0.1.  [SETTINGS] LLM_TEMPERATURE=... 는 실수가 아닙니다.
LLM_TEMPERATURE=0.1

# LLM 최대 출력 토큰.  1 ~ 32768
# 안 넣으면:  4096
# 정수가 아니거나 0 이하: 경고 후 4096
LLM_MAX_TOKENS=4096

# 세션 유휴 타임아웃(초). 하트비트도 질문도 없으면 이만큼 뒤에 닫는다.
# 안 넣으면:  1800 (30분).  최소 60 으로 강제된다.
#
# ⚠️ 처리 중(processing=True)인 세션은 스윕이 건드리지 않는다.
SESSION_IDLE_TTL_SEC=1800

# Ctrl-C / SIGTERM 시 in-flight /ask 를 기다리는 최대 시간(초).
# 안 넣으면:  30
SHUTDOWN_GRACE_SEC=30

# 임베딩/리랭커 모델 언로드 TTL(초). refcount=0 이고 이만큼 유휴면 메모리에서 내린다.
# 안 넣으면:  600 (10분).  최소 30 으로 강제된다.
#
# 짧게 잡으면 모델 재로드가 잦아지고(수 초), 길게 잡으면 메모리를 오래 문다.
# GPU 가 넉넉하면 3600 정도로 늘려도 좋다.
MODEL_IDLE_TTL_SEC=600

# 메인 프롬프트에 들어가는 조직 소개 문구.
# 안 넣으면:  "우리 회사는 세무·회계 업무를 수행하며 관련 법령을 준수합니다."
#
# 🔴 주의: 클라이언트가 general_settings.company_summary 로 빈 문자열("")을
#    보내면 workflow_orchestrator.py:175 에서 NameError 가 난다(알려진 한계).
#    여기 환경변수를 비우는 것은 안전하다(기본 문구로 대체됨).
COMPANY_SUMMARY=


# -----------------------------------------------------------------------------
# [선택 — Neo4j]  use_graphdb=true 로 쓸 때만
# -----------------------------------------------------------------------------

# 안 넣으면:  bolt://localhost:7687 / neo4j 로 시도한다.
# 접속 실패:  [WARN] Neo4j 미연결. use_graphdb 는 빈 보충만 반환합니다.
#             → 부팅은 성공한다. 그래프 채널만 조용히 비활성화된다.
#
# ⚠️ Neo4j Law 노드는 법령 원본 id 만 갖는다(rag_run.LAW_GRAPH_TABLE).
#    tax_laws_master 가 아닌 테이블의 hit 는 그래프 조회에 쓰이지 않는다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# ⚠️ Docker Compose(./deploy.sh)로 띄울 때는 이 항목이 [필수]다. 직접 정해서 넣는다(8자 이상).
#    비어 있으면 deploy.sh 가 안내하고 멈춘다. (위의 "안 넣으면" 설명은 Compose 없이 직접 실행할 때의 이야기)
NEO4J_PASSWORD=


# -----------------------------------------------------------------------------
# [선택 — 수업 운영]
# -----------------------------------------------------------------------------

# /admin/* 을 호출할 수 있는 IP. 쉼표로 여러 개.
# 안 넣으면:  127.0.0.1 (::1, localhost, ::ffff:127.0.0.1 자동 포함)
# 여기 없는 IP:  ADMIN_FORBIDDEN_IP (403)
CS_ALLOW_IP=127.0.0.1

# cs_console.py 가 붙을 서버 주소. 서버 자체에는 영향 없다.
# 안 넣으면:  http://127.0.0.1:8000
RAG_SERVER=http://127.0.0.1:8000


# -----------------------------------------------------------------------------
# [선택 — 테스트셋 생성]  build_testset.py --engine gemini 일 때만
# -----------------------------------------------------------------------------

# 안 넣으면:  engine=gemini 에는 GEMINI_API_KEY(또는 GOOGLE_API_KEY)가 필요합니다.
#             → --engine template 를 쓰면 LLM 없이 시험지를 만들 수 있다.
#
# ⚠️ 서버 LLM 과 일부러 다른 SDK 를 쓴다. 출제자와 응시자를 분리하기 위해서다.
#    (→ ADR-009)
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# [선택 — 공격성 호출 차단 및 쿼터 제한 (Rate Limiting)]
# -----------------------------------------------------------------------------

# 일일 무료 질문 가능 횟수. (기본값: 5회)
# 안 넣으면: 5
RATE_LIMIT_DAILY=5

# 질문 간 최소 쿨다운 대기 시간 (초 단위). (기본값: 900초 = 15분)
# 30분으로 늘릴 경우 1800으로 설정.
# 안 넣으면: 900
RATE_LIMIT_COOLDOWN_SEC=900

# 레이트 리미트 활성화 여부 (true / false).
# 안 넣으면: true
RATE_LIMIT_ENABLED=true

# 쿼터 원장 저장 파일 경로.
# 안 넣으면: logs/quotas.json
RATE_LIMIT_FILE=logs/quotas.json


# =============================================================================
# 부팅 전 체크리스트
# =============================================================================
#  [ ] .env                      이 파일
#  [ ] embedding_models.json     "indexed": true 항목이 최소 1개
#  [ ] reranker_models.json      저장소에 있음
#  [ ] openrouter_models.json    OpenRouter 카탈로그
#  [ ] prompts_ko_세무.json      main_answer 필수
#  [ ] PostgreSQL                psql -f database/init.sql
#  [ ] (선택) session_users.json --login-mode 일 때만
#  [ ] (선택) models/*.gguf      DEFAULT_LLM=local:* 일 때만
#
# 확인:  curl http://127.0.0.1:8000/health
#        → contracts.problems 와 boot.env_warnings 를 볼 것
# =============================================================================
